# Optional. Only needed with a custom domain: Vercel already provides its own address.
# The full public address of the invitation, used in share links, calendar files and previews.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# RSVP replies → Google Sheet (see "RSVP: connect your Google Sheet" in README.md).
# Server-only secrets: set them in Vercel → Settings → Environment Variables, never in code.
# RSVP_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
# RSVP_SHEET_SECRET=a-long-random-secret
